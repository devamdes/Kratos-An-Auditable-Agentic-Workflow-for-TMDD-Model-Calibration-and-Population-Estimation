# Copy to .env (never commit .env). Kratos reads credentials only from the environment and
# excludes them from snapshots, reports and export bundles.

# Optional: LLM-assisted planning (calibration.planner: llm and llm.enabled: true)
ANTHROPIC_API_KEY=

# Optional: explicit Rscript path (otherwise PATH and standard install locations are searched)
KRATOS_RSCRIPT=

# Set to 1 to force the calibration-only (no R) path, e.g. for testing
KRATOS_DISABLE_R=0
